// Prisma schema: the single source of truth for our database tables.
// Change this file, then run `npm run db:migrate -- --name what_changed`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  // Stored lowercased by the app so "Ann@x.com" and "ann@x.com" are one account.
  email        String   @unique
  name         String
  // Never the password itself: an argon2id hash that includes its own salt.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  refreshTokens   RefreshToken[]
  memberships     Membership[]
  invitationsSent Invitation[]   @relation("InvitedBy")
  projectsCreated Project[]      @relation("ProjectCreatedBy")
  tasksCreated    Task[]         @relation("TaskCreatedBy")
  tasksAssigned   Task[]         @relation("TaskAssignee")

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  // SHA-256 of the token. If the database leaks, the tokens are still useless.
  tokenHash String    @unique @map("token_hash")
  // Every token created by rotating from the same login shares a family.
  // If an old token in a family is reused, the whole family is revoked.
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Workspaces (step 4). A workspace is a "tenant": a team's private space.
// Every project and task added in step 5 will belong to exactly one workspace.
// ---------------------------------------------------------------------------

// Ordered from most to least powerful. The ranking lives in workspaces.policy.ts.
enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships Membership[]
  invitations Invitation[]
  projects    Project[]

  @@map("workspaces")
}

// The join table between users and workspaces, carrying the user's role there.
// A composite primary key (workspace_id, user_id) makes "member twice" impossible.
model Membership {
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Deleting a workspace removes its memberships.
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Restrict: the database refuses to delete a user who still belongs to a
  // workspace, so an account deletion can never silently leave a team ownerless.
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  // The primary key already indexes workspace_id first; this one makes
  // "which workspaces is this user in?" fast too.
  @@id([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  // Lowercased, like users.email, so matching is case-insensitive.
  email       String
  role        WorkspaceRole
  // Like refresh tokens: only the SHA-256 hash of the secret token is stored.
  tokenHash   String        @unique @map("token_hash")
  invitedById String?       @map("invited_by_id") @db.Uuid
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  revokedAt   DateTime?     @map("revoked_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User?     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Projects and tasks (step 5). Both live inside a workspace: every query
// that reads or writes them is scoped by workspace_id (see LEARNING.md,
// chapter 5).
// ---------------------------------------------------------------------------

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Project {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  name        String
  description String   @default("")
  createdById String?  @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Deleting a workspace deletes its projects, and their tasks with them.
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User?     @relation("ProjectCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  tasks     Task[]

  // Lets a task reference "this project, in this workspace" as one key.
  @@unique([id, workspaceId])
  // The project list is ordered by creation time, with the id as tiebreaker.
  @@index([workspaceId, createdAt, id])
  @@map("projects")
}

model Task {
  id          String       @id @default(uuid()) @db.Uuid
  // Copied from the project on purpose ("denormalized"): it lets every task
  // query be scoped by workspace directly, and lets removing a member
  // unassign all their tasks in that workspace with one indexed update.
  workspaceId String       @map("workspace_id") @db.Uuid
  projectId   String       @map("project_id") @db.Uuid
  title       String
  description String       @default("")
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  // A calendar date, not a moment in time: no hours, no time zone.
  dueDate     DateTime?    @map("due_date") @db.Date
  assigneeId  String?      @map("assignee_id") @db.Uuid
  createdById String?      @map("created_by_id") @db.Uuid
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  // The foreign key covers BOTH columns: (project_id, workspace_id) must be
  // an existing project in that workspace. So the database itself guarantees
  // that the copied workspace_id is right. Deleting a project (or its
  // workspace, which deletes its projects) deletes its tasks.
  project   Project @relation(fields: [projectId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  assignee  User?   @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User?   @relation("TaskCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // One index per way the list can be sorted (always within one project,
  // with the id as tiebreaker), plus one for "tasks assigned to this member".
  @@index([projectId, createdAt, id])
  @@index([projectId, updatedAt, id])
  @@index([projectId, dueDate, id])
  @@index([workspaceId, assigneeId])
  @@map("tasks")
}
